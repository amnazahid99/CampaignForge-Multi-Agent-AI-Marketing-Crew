# Ollama settings (local LLM inference)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT=120

# Embedding model
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Campaign storage
CAMPAIGN_STORE_PATH=./campaigns
VECTOR_STORE_PATH=./faiss_db

# Document processing
CHUNK_SIZE=800
CHUNK_OVERLAP=100
MAX_RESULTS=5
MAX_HISTORY=10
MAX_CAMPAIGN_REVISIONS=3

# File uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=.pdf,.docx,.txt,.md,.csv

# Web search (optional — leave empty for demo mode)
WEB_SEARCH_PROVIDER=demo
TAVILY_API_KEY=
SERPER_API_KEY=
WEB_SEARCH_TIMEOUT=30

# Observability
LOG_LEVEL=INFO

# Security
API_KEY_HEADER=X-API-Key
API_KEY=
